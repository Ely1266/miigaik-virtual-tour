@startuml components
skinparam componentStyle uml2
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
package "Клиентское веб-приложение" {
  component "Контроллер\nmain.ts" as App
  component "Загрузка и адаптер\ntourData.ts" as Adapter
  component "Pannellum 2.5.7" as Viewer
  component "Интерфейс\nindex.html / style.css" as UI
  component "Контракты данных\ntypes.ts" as Types
  component "Leaflet / мини-карта" as Map <<планируется>>
}
package "Статические ресурсы HTTP" {
  component "data/scenes.json" as Json
  component "panoramas/" as Tiles
  component "floorplans/" as Plans <<планируется>>
}
App --> Adapter : конфигурация
App <--> Viewer : управление / load
App <--> UI : события / обновление
Adapter --> Types : типы
App --> Types : типы
Adapter --> Json : GET JSON
Viewer --> Tiles : GET JPEG
App ..> Map : этаж / позиция
Map ..> Plans : GET PNG
note bottom of Tiles
  Локальный HTTP-сервер — текущий запуск.
  GitHub Pages — планируемая публикация.
end note
@enduml
