@startuml sequence_hotspot
autonumber
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12

actor "Пользователь" as User
participant "PannellumViewer" as Viewer
participant "main.ts" as Ctrl
participant "currentConfig\n(ScenesConfig)" as Data
participant "UI: заголовок и меню" as UI
participant "LeafletMiniMap\n(планируется)" as Map

User -> Viewer : Клик на стрелку перехода (HotSpot)
activate Viewer
Viewer -> Viewer : Переход по sceneId, targetPitch, targetYaw
Viewer -> Viewer : Загрузка и отрисовка панорамы
Viewer -> Ctrl : Событие load
activate Ctrl
Ctrl -> Viewer : getScene()
Viewer --> Ctrl : activeSceneId
deactivate Viewer
Ctrl -> Ctrl : onSceneChange(activeSceneId)
Ctrl -> Data : Чтение scenes[sceneId] и поиск floors по floorId
Data --> Ctrl : Данные сцены и этажа
Ctrl -> UI : Обновить название, этаж и активный пункт меню
opt Планируемая функциональность: мини-карта
    Ctrl -> Map : Обновить положение (floorId, floorPosition)
    opt Этаж изменился
        Map -> Map : Переключить подложку этажа
    end
    Map -> Map : Переместить маркер при наличии координат
end
deactivate Ctrl
@enduml
