@startuml classes
skinparam classAttributeIconSize 0
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
hide methods
hide empty members
class ScenesConfig <<interface>> {
  + defaultScene: string
  + floors: FloorInfo[]
  + scenes: Record<string, SceneData>
}
class SceneData <<interface>> {
  + title: string
  + floorId: string
  + type: equirectangular | cubemap | multires
  + yaw?, pitch?, hfov?: number
  + panorama?: string
  + multiRes?: MultiResConfig
  + floorPosition?: FloorPosition
  + hotSpots?: HotSpotData[]
}
class FloorInfo <<interface>> {
  + id: string
  + name: string
  + level: number
  + planImage: string
}
class FloorPosition <<interface>> {
  + x: number
  + y: number
}
class HotSpotData <<interface>> {
  + type: scene | info
  + pitch, yaw: number
  + text: string
  + sceneId?: string
  + targetYaw?, targetPitch?: number
  + infoTitle?, infoBody?, infoImage?: string
}
class MultiResConfig <<interface>> {
  + basePath, path, fallbackPath: string
  + extension: string
  + tileResolution: number
  + maxLevel: number
  + cubeResolution: number
}
ScenesConfig "1" *-- "1..*" SceneData : содержит
ScenesConfig "1" *-- "1..*" FloorInfo : содержит
SceneData "1" *-- "0..*" HotSpotData : метки
SceneData "1" *-- "0..1" FloorPosition : координаты
SceneData "1" *-- "0..1" MultiResConfig : параметры
SceneData "0..*" --> "1" FloorInfo : floorId
HotSpotData "0..*" --> "0..1" SceneData : sceneId
note bottom of FloorInfo
  planImage — путь к планируемой подложке;
  тип данных уже присутствует.
end note
@enduml
